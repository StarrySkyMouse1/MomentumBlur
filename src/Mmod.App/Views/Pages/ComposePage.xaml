<Page x:Class="Mmod.App.Views.Pages.ComposePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:Mmod.App.Converters"
      Title="录制与处理"
      ScrollViewer.CanContentScroll="False"
      AllowDrop="True"
      Drop="Page_Drop"
      DragOver="Page_DragOver">
    <Page.Resources>
        <conv:BatchStatusToSeverityConverter x:Key="BatchSeverity" />

        <!-- OBS 队列行状态：ui:InfoBadge 表达语义，颜色全部走 InfoBadgeSeverity -->
        <DataTemplate x:Key="BatchStatusBadgeTemplate">
            <StackPanel Orientation="Horizontal">
                <ui:InfoBadge Severity="{Binding Status, Converter={StaticResource BatchSeverity}}"
                              VerticalAlignment="Center" />
                <ui:TextBlock Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              FontTypography="Caption"
                              TextTrimming="CharacterEllipsis"
                              Text="{Binding Status}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!--
        OBS 顶层模式工作台：三步连续信息层级
          ① 准备：复制慢放 / 恢复指令（与设置页共用同一份配置与命令）
          ② 在外部 OBS 录制（用户自行操作 OBS，本应用不自动控制）
          ③ 导入视频并批量处理（文件选择 / 拖放 / 队列 / 批处理 / 取消 / 状态反馈）
        TGA 手工合成入口已不在主导航暴露，原 TGA 监视投影在本页移除；
        TgaPipelineOrchestrator 与相关命令仍保留在 ViewModel 中，未删除、未重写。
    -->
    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 真实模式摘要；右侧为当前输出盘状态（只读投影） -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource AppPageTitle}" Text="{Binding PageTitleText}" />
                <ui:TextBlock Style="{StaticResource AppPageSubtitle}" Text="{Binding ModeSummary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                <ui:TextBlock Style="{StaticResource AppKeyText}" Text="{Binding DiskDetailText}" />
                <ui:InfoBadge Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Severity="{Binding DiskSeverity}"
                              Value="{Binding DiskStateText}" />
            </StackPanel>
        </Grid>

        <!-- 主体：主栏（③ 处理工作区） + 侧栏（①② 准备与录制） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="250" MinWidth="230" />
            </Grid.ColumnDefinitions>

            <!-- ===== 主栏：③ 导入视频并批量处理 ===== -->
            <!--
                容器统一用 ui:Card：CardControl 是 ButtonBase + [Icon][Header*][Content(Auto)]
                的行式模板，把它当内容容器会让内容按自然宽度右对齐并溢出，同时把交互控件
                嵌在按钮里。ui:Card 的 ContentPresenter 是 Stretch，内容才占满整卡。
                圆角取框架 ControlCornerRadius（与任务页、设置页的卡片一致）。
            -->
            <ui:Card Grid.Column="0"
                     Padding="0"
                     VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 卡头：标题（左） + 操作按钮（右），WrapPanel 在窄宽度下自动换行不叠压 -->
                    <Grid Grid.Row="0" Margin="16,14,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Text="③ 导入视频并批量处理"
                                      FontTypography="BodyStrong" />
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <ui:Button Content="添加视频…"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Appearance="Secondary"
                                       Command="{Binding AddVideosCommand}"
                                       Margin="0,0,8,8" />
                            <ui:Button Content="开始批量合成"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Appearance="Primary"
                                       Command="{Binding StartObsBatchCommand}"
                                       Margin="0,0,8,8" />
                            <ui:Button Content="取消"
                                       Appearance="Secondary"
                                       Command="{Binding CancelObsBatchCommand}"
                                       Margin="0,0,8,8" />
                            <ui:Button Content="清空队列"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Appearance="Danger"
                                       Command="{Binding ClearBatchCommand}"
                                       Margin="0,0,8,8" />
                        </WrapPanel>
                    </Grid>

                    <!-- 队列统计 + 输出盘空间 -->
                    <StackPanel Grid.Row="1" Margin="16,4,16,0">
                        <ui:TextBlock Text="{Binding BatchSummary}"
                                      FontTypography="Body"
                                      Appearance="Secondary"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Margin="0,6,0,0"
                                      Style="{StaticResource AppCaptionMuted}"
                                      Text="{Binding DiskSpaceText}" />
                    </StackPanel>

                    <!-- 拖放落区：页级 AllowDrop 已生效，这里给出可见落点 -->
                    <Border Grid.Row="2"
                            Margin="16,12,16,0"
                            Padding="14,10,14,10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          FontTypography="Body"
                                          Appearance="Secondary"
                                          Text="把 OBS 导出的 MP4 / MKV 拖到这里，或点击「添加视频…」" />
                        </StackPanel>
                    </Border>

                    <!-- 队列表格：标题行 + 表格本体，本体在 * 行内自行滚动 -->
                    <Grid Grid.Row="3" Margin="16,14,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="批量队列"
                                          FontTypography="BodyStrong" />
                            <ui:TextBlock Grid.Column="1"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="清空队列需先取消或等待批量结束" />
                        </Grid>

                        <ui:DataGrid Grid.Row="1"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     CanUserResizeRows="False"
                                     HeadersVisibility="Column"
                                     GridLinesVisibility="None"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ColumnHeaderStyle="{StaticResource AppGridColumnHeader}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemsSource="{Binding BatchItems}">
                            <ui:DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选"
                                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="44" />
                                <DataGridTextColumn Header="文件"
                                                    Binding="{Binding Name}"
                                                    IsReadOnly="True"
                                                    Width="*"
                                                    FontFamily="JetBrains Mono, Consolas, monospace" />
                                <DataGridTextColumn Header="进度"
                                                    Binding="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                    IsReadOnly="True"
                                                    Width="70" />
                                <DataGridTemplateColumn Header="状态"
                                                        IsReadOnly="True"
                                                        Width="2*"
                                                        CellTemplate="{StaticResource BatchStatusBadgeTemplate}" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </Grid>

                    <!-- 运行消息：Severity 走真实投影（信息 / 警告 / 严重） -->
                    <ui:InfoBar Grid.Row="4"
                                Margin="16,12,16,16"
                                Severity="{Binding StatusSeverity}"
                                Title="运行消息"
                                Message="{Binding StatusText}"
                                IsClosable="False"
                                IsOpen="True" />
                </Grid>
            </ui:Card>

            <!-- ===== 侧栏：①② 准备与外部录制 ===== -->
            <ScrollViewer Grid.Column="2"
                          Padding="0,0,4,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          Focusable="True">
                <StackPanel>
                    <!-- ① 准备 -->
                    <ui:Card Margin="0,0,0,14" Padding="16"
                             VerticalAlignment="Top">
                        <StackPanel>
                            <ui:TextBlock Text="① 准备：慢放与恢复指令" FontTypography="BodyStrong" />
                            <ui:TextBlock Margin="0,8,0,0"
                                          Style="{StaticResource AppHelperText}"
                                          Text="先在游戏控制台执行慢放指令，再到外部 OBS 录制；录制结束后执行恢复指令还原设置。" />

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,12,0,4"
                                          Text="慢放指令" />
                            <ui:TextBox Style="{StaticResource AppCodeBlock}"
                                        MinHeight="72"
                                        Text="{Binding Settings.SlowMotionBlock}" />

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,10,0,4"
                                          Text="恢复指令" />
                            <ui:TextBox Style="{StaticResource AppCodeBlock}"
                                        MinHeight="56"
                                        Text="{Binding Settings.RestoreBlock}" />

                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Content="复制慢放指令"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Appearance="Secondary"
                                           Command="{Binding Settings.CopySlowMotionCommand}"
                                           Margin="0,0,8,8" />
                                <ui:Button Content="复制恢复指令"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Appearance="Secondary"
                                           Command="{Binding Settings.CopyRestoreCommand}"
                                           Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- ② 外部 OBS 录制 -->
                    <ui:Card Margin="0,0,0,14" Padding="16"
                             VerticalAlignment="Top">
                        <StackPanel>
                            <ui:TextBlock Text="② 在外部 OBS 录制" FontTypography="BodyStrong" />
                            <ui:TextBlock Margin="0,8,0,0"
                                          Style="{StaticResource AppHelperText}"
                                          Text="{Binding ObsRecordingHint}" />
                            <ui:Button Margin="0,12,0,0"
                                       Content="打开成片目录"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Command="{Binding OpenOutputFolderCommand}" />
                            <ui:TextBlock Margin="0,8,0,0"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="{Binding ObsOutputDirectoryText}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- 本会话：只保留 OBS 批量真实计数 -->
                    <ui:Card Padding="16" VerticalAlignment="Top">
                        <StackPanel>
                            <ui:TextBlock Text="本会话" FontTypography="BodyStrong" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" Style="{StaticResource AppKeyText}" Text="状态" />
                                <ui:TextBlock Grid.Column="1" Style="{StaticResource AppValueText}"
                                              Text="{Binding StatusText}"
                                              TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ui:TextBlock Margin="0,8,0,0"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="{Binding BatchSummary}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
