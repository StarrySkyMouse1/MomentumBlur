<Page x:Class="Mmod.App.Views.Pages.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Mmod.App.ViewModels"
      xmlns:conv="clr-namespace:Mmod.App.Converters"
      ScrollViewer.CanContentScroll="False"
      Title="任务">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:TaskStateToBrushConverter x:Key="StateBrush"/>
        <conv:TaskProgressBrushConverter x:Key="ProgressBrush"/>
        <conv:BooleanToControlAppearanceConverter x:Key="SegmentAppearance"/>

        <!--
            回放树行：地图 / 玩家 / 赛道 · 阶段 / 记录。
            必须是 HierarchicalDataTemplate：TreeViewItem 的子树只来自
            HierarchicalDataTemplate.ItemsSource。用普通 DataTemplate 时
            TreeViewItem.HasItems 恒为 false，而 TreeViewItem.xaml 模板里有
            「HasItems=False → Expander 隐藏」的触发器，于是既不显示展开箭头
            也不生成任何子容器 —— 表现就是只看到根节点、一个勾选框都没有。
            容器与选中视觉仍然全部交给 TreeViewItem 的框架隐式样式。
        -->
        <HierarchicalDataTemplate x:Key="ReplayRowTemplate"
                                  DataType="{x:Type vm:ReplayTreeNode}"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsSelectable}"
                          ToolTip="{Binding DisabledReason}"
                          Visibility="{Binding CheckVisibility}"
                          Style="{StaticResource AppReplayRowCheckBox}"/>

                <ui:SymbolIcon Grid.Column="1"
                               Symbol="{Binding Icon}"
                               FontSize="12"
                               Filled="True"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding IconVisibility}"/>

                <ui:TextBlock Grid.Column="2"
                              Text="{Binding Label}"
                              VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis"
                              FontFamily="JetBrains Mono, Consolas, monospace"
                              FontTypography="Caption"
                              Foreground="{Binding LabelForeground}"/>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- 队列任务卡：ui:Card 提供 Fluent 卡片视觉，状态由语义色描边表达 -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type vm:TaskListItem}">
            <ui:Card Padding="12,10,12,10"
                     ToolTip="{Binding Detail}"
                     BorderBrush="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=border}">
                <StackPanel>
                    <Grid>
                        <ui:TextBlock HorizontalAlignment="Left"
                                      FontTypography="BodyStrong"
                                      Text="{Binding Title}"
                                      TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      FontTypography="Caption"
                                      Text="{Binding StatusText}"
                                      Foreground="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=text}"/>
                    </Grid>
                    <ProgressBar Height="6"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding ProgressRatio, Mode=OneWay}"
                                 Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                 Foreground="{Binding State, Converter={StaticResource ProgressBrush}}"
                                 BorderThickness="0"/>
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskNodeItem}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="14" Height="14"
                                            CornerRadius="7"
                                            BorderThickness="2"
                                            BorderBrush="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=text}"
                                            Background="{Binding State, Converter={StaticResource ProgressBrush}}"
                                            VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1"
                                                 Height="7"
                                                 Margin="0,0,10,0"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding ProgressRatio, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsRunning}"
                                                 Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                                 Foreground="{Binding State, Converter={StaticResource ProgressBrush}}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"/>
                                    <ui:TextBlock Grid.Column="2"
                                                  MinWidth="112"
                                                  FontTypography="Caption">
                                        <ui:TextBlock.Inlines>
                                            <Run Text="{Binding Label}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Value}"/>
                                        </ui:TextBlock.Inlines>
                                    </ui:TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </DataTemplate>

        <!-- 节点进度行：语义色徽标 + 文案 -->
        <DataTemplate x:Key="TaskNodeTemplate" DataType="{x:Type vm:TaskNodeItem}">
            <Grid Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:InfoBadge Severity="{Binding Severity}"
                                  VerticalAlignment="Center"
                                  CornerRadius="4"/>
                    <ui:TextBlock Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  FontTypography="Body"
                                  Text="{Binding Label}"/>
                </StackPanel>
                <ui:TextBlock HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              FontFamily="JetBrains Mono, Consolas, monospace"
                              FontTypography="Caption"
                              Text="{Binding Value}"
                              Foreground="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=text}"/>
            </Grid>
        </DataTemplate>

        <!--
            回放树容器样式（画板 03）
            原生 TreeView 用 ItemsSource 生成容器时创建的是「原生 TreeViewItem」：
            WPF-UI 没有 TreeView 子类（只有 ListView / BreadcrumbBar 覆写了
            GetContainerForItemOverride），所以 ItemContainerStyle 的 TargetType
            必须是原生 TreeViewItem。写成 ui:TreeViewItem 会在生成容器那一刻抛
            InvalidOperationException「用于类型 TreeViewItem 的样式不能应用于类型
            TreeViewItem」——两个类型同名，报错信息看起来像自相矛盾。
            选中竖条无需额外处理：TreeViewItem.xaml 里 DefaultTreeViewItemStyle 本身
            带 ActiveRectangle（TreeViewItemSelectionIndicatorForeground），并且已经
            作为原生 TreeViewItem 的隐式样式注册。这里只补 Padding / 伸展 / 展开态。
            展开态走数据：容器的 DataContext 是页面 VM 而不是节点，所以经 Header
            取节点上的 IsExpanded（TwoWay，用户手动折叠同样回写）。
        -->
        <Style x:Key="AppReplayTreeItem" TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource DefaultTreeViewItemStyle}">
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded"
                    Value="{Binding Header.IsExpanded, RelativeSource={RelativeSource Self}, Mode=TwoWay}" />
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Left">
            <ui:TextBlock Style="{StaticResource AppPageTitle}" Text="任务"/>
            <ui:TextBlock Style="{StaticResource AppPageSubtitle}"
                          Text="勾选回放 → 创建任务 → 队列执行 → 自动收尾合并"/>
        </StackPanel>

        <!-- 操作工具条：队列启停常驻；回放刷新在回放记录页签内 -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <ui:Button Content="开始 / 继续"
                       Icon="{ui:SymbolIcon Play24}"
                       Appearance="Primary"
                       Command="{Binding StartQueueCommand}"
                       Style="{StaticResource AppToolbarButton}"/>
            <ui:Button Content="当前节点后暂停"
                       Icon="{ui:SymbolIcon Pause24}"
                       Command="{Binding PauseAfterNodeCommand}"
                       Style="{StaticResource AppToolbarButton}"/>
            <ui:Button Content="立即停止"
                       Icon="{ui:SymbolIcon Stop24}"
                       Appearance="Danger"
                       Command="{Binding StopNowCommand}"
                       Style="{StaticResource AppToolbarButtonLast}"/>
        </StackPanel>

        <!--
            任务状态条：所有操作（刷新 / 创建 / 队列启停）的统一反馈出口。
            此前任务页只有 StatusText 属性、没有任何可视出口，失败原因会被静默丢弃，
            表现就是「点了按钮没有任何反应」；Severity 由真实文案/异常分类得出。
        -->
        <ui:InfoBar Grid.Row="2"
                    Margin="0,0,0,12"
                    Severity="{Binding StatusSeverity}"
                    Message="{Binding StatusText}"
                    IsClosable="False"
                    IsOpen="True"/>

        <!-- 主体：三页签 + 底部常驻遥测 -->
        <ui:TabView Grid.Row="3"
                    Margin="0,0,0,12"
                    SelectedIndex="0">
            <!-- 页签一：回放记录 -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" Margin="0,0,6,0"/>
                        <TextBlock Text="回放记录"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索 + 刷新 + 计数 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:AutoSuggestBox Grid.Column="0"
                                           MinWidth="0"
                                           PlaceholderText="搜索地图 / 玩家 / 赛道"
                                           Icon="{ui:SymbolIcon Search24}"
                                           ClearButtonEnabled="True"
                                           Text="{Binding CatalogFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Content="刷新"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RefreshCatalogCommand}"/>
                        <ui:TextBlock Grid.Column="2"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      FontTypography="Caption"
                                      Appearance="Tertiary"
                                      TextWrapping="NoWrap"
                                      Text="{Binding CatalogCountText}"/>
                    </Grid>

                    <!-- 回放树：容器样式只设间距，模板由框架隐式样式提供 -->
                    <Grid Grid.Row="1">
                        <TreeView ItemsSource="{Binding CatalogView}"
                                  ItemTemplate="{StaticResource ReplayRowTemplate}"
                                  ItemContainerStyle="{StaticResource AppReplayTreeItem}"
                                  Style="{StaticResource AppTreeView}"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsCatalogEmpty, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- 空态占位（画板 04 · ③） -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="320"
                                    Visibility="{Binding IsCatalogEmpty, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Style="{StaticResource AppEmptyStateIcon}" />
                            <ui:TextBlock Style="{StaticResource AppEmptyStateTitle}" Text="暂无回放记录" />
                            <ui:TextBlock Style="{StaticResource AppEmptyStateHint}" Text="{Binding CatalogEmptyHint}" />
                        </StackPanel>
                    </Grid>

                    <!-- 选择条 -->
                    <ui:Card Grid.Row="2"
                             Margin="0,10,0,0"
                             Padding="10,8,10,8"
                             Background="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"
                             BorderBrush="{DynamicResource AccentControlElevationBorderBrush}">
                        <Grid>
                            <ui:TextBlock VerticalAlignment="Center"
                                          FontTypography="Caption"
                                          Text="{Binding SelectionCountText}"
                                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 规范 07：每屏仅一个 Primary（常驻工具条的「开始 / 继续」），此处并列次要操作 -->
                                <ui:Button Content="创建任务"
                                           Appearance="Secondary"
                                           Command="{Binding CreateTasksCommand}"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>
            </ui:TabViewItem>

            <!-- 页签二：执行队列（页签头带队列计数徽标，画板 03） -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="List24" Margin="0,0,6,0"/>
                        <TextBlock Text="执行队列" VerticalAlignment="Center"/>
                        <ui:InfoBadge Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Severity="Attention"
                                      Value="{Binding QueueCount}"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 分段器：ui:Button 的 Appearance 表达选中态 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Content="执行队列"
                                       Appearance="{Binding IsQueueTabSelected, Converter={StaticResource SegmentAppearance}}"
                                       Style="{StaticResource AppSegmentButton}"
                                       Command="{Binding ShowQueueTabCommand}"
                                       Margin="0,0,6,0"/>
                            <ui:Button Content="历史"
                                       Appearance="{Binding IsHistoryTabSelected, Converter={StaticResource SegmentAppearance}}"
                                       Style="{StaticResource AppSegmentButton}"
                                       Command="{Binding ShowHistoryTabCommand}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="上移"
                                       Icon="{ui:SymbolIcon ArrowUp24}"
                                       Appearance="Secondary"
                                       Command="{Binding MoveUpCommand}"
                                       Margin="0,0,6,0"/>
                            <ui:Button Content="下移"
                                       Icon="{ui:SymbolIcon ArrowDown24}"
                                       Appearance="Secondary"
                                       Command="{Binding MoveDownCommand}"
                                       Margin="0,0,6,0"/>
                            <ui:Button Content="删除记录"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Appearance="Danger"
                                       Command="{Binding DeleteTaskCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 任务卡列表：ui:ListView + ui:ListViewItem
                         注意：WPF-UI 未给 ListView / ListViewItem 提供带键 Default 样式，
                         因此这里不设 Style（避免覆盖隐式样式），只在使用处设局部属性。 -->
                    <Grid Grid.Row="1">
                        <ui:ListView ItemsSource="{Binding Queue}"
                                     SelectedItem="{Binding SelectedTask}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     Margin="0"
                                     ItemTemplate="{StaticResource TaskCardTemplate}"
                                     Visibility="{Binding IsQueueTabSelected, Converter={StaticResource BoolToVis}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                        </ui:ListView>
                        <ui:ListView ItemsSource="{Binding History}"
                                     SelectedItem="{Binding SelectedTask}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     Margin="0"
                                     ItemTemplate="{StaticResource TaskCardTemplate}"
                                     Visibility="{Binding IsQueueTabSelected, Converter={StaticResource InverseBoolToVis}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ui:ListViewItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                        </ui:ListView>

                        <!-- 空态占位（画板 04 · ③）：队列 / 历史各自一条，互不遮挡列表 -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="320"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsQueueTabSelected}" Value="True"/>
                                                <Condition Binding="{Binding IsQueueEmpty}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsQueueTabSelected}" Value="False"/>
                                                <Condition Binding="{Binding IsHistoryEmpty}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Style="{StaticResource AppEmptyStateIcon}" />
                            <ui:TextBlock Style="{StaticResource AppEmptyStateTitle}" Text="暂无任务" />
                            <ui:TextBlock Style="{StaticResource AppEmptyStateHint}"
                                          Text="在「回放记录」页签勾选记录并创建任务后，任务会出现在这里" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBlock Grid.Row="2"
                                  Margin="0,8,0,0"
                                  Style="{StaticResource AppCaptionMuted}"
                                  Text="只有待执行任务可以上移 / 下移；正在执行的任务需先暂停或停止才能删除。"/>
                </Grid>
            </ui:TabViewItem>

            <!-- 页签三：任务详情 -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0"/>
                        <TextBlock Text="任务详情"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <ui:TextBlock HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppCardTitle}"
                                      Text="任务详情"/>
                        <ui:InfoBadge HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Severity="{Binding DetailSeverity}"
                                      Value="{Binding DetailStateText}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                        <!-- 空状态：未选中任务 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,40,0,0"
                                    Visibility="{Binding IsDetailEmpty, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           Style="{StaticResource AppEmptyStateIcon}"/>
                            <ui:TextBlock HorizontalAlignment="Center"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource AppEmptyStateTitle}"
                                          Text="未选中任务"/>
                            <ui:TextBlock HorizontalAlignment="Center"
                                          Margin="0,4,0,0"
                                          Style="{StaticResource AppEmptyStateHint}"
                                          Text="在上方「执行队列」或「回放记录」中选择一项，这里会显示冻结配置、节点进度与最近日志"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDetailEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <!-- 冻结配置 -->
                            <ui:Card Padding="12"
                                     Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource AppCaptionMuted}"
                                                  Margin="0"
                                                  Text="冻结配置（任务创建时写入快照，之后改全局设置不影响本任务）"/>
                                    <ui:TextBlock Margin="0,6,0,0"
                                                  Style="{StaticResource AppBodyText}"
                                                  Text="{Binding FrozenComposeText}"/>
                                    <ui:TextBlock Margin="0,2,0,0"
                                                  Style="{StaticResource AppCaptionMuted}"
                                                  Text="{Binding FrozenQualityText}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:TextBlock Style="{StaticResource AppFieldLabel}"
                                                          Margin="0"
                                                          Text="前台 TGA 生成速率上限（fps）"/>
                                            <ui:TextBlock Margin="0,3,12,0"
                                                          Style="{StaticResource AppCaptionMuted}"
                                                          Text="0 表示不覆盖；修改后保留已完成节点，从失败或待执行节点继续。"/>
                                        </StackPanel>
                                        <ui:NumberBox Grid.Column="1"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Value="{Binding SelectedTaskForegroundCaptureFpsLimit, Mode=TwoWay}"
                                                      ValueChanged="OnNumberBoxValueChanged"
                                                      Minimum="0"
                                                      Maximum="1000"
                                                      SmallChange="10"
                                                      SpinButtonPlacementMode="Hidden"
                                                      IsEnabled="{Binding CanEditSelectedTaskForegroundCaptureFpsLimit}"/>
                                        <ui:Button Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Content="应用"
                                                   IsEnabled="{Binding CanEditSelectedTaskForegroundCaptureFpsLimit}"
                                                   Command="{Binding ApplySelectedTaskForegroundCaptureFpsLimitCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- 节点进度 -->
                            <ui:TextBlock Margin="0,12,0,6"
                                          Style="{StaticResource AppSectionLabel}"
                                          Text="节点进度"/>
                            <ItemsControl ItemsSource="{Binding DetailNodes}"
                                          ItemTemplate="{StaticResource TaskNodeTemplate}"/>

                            <!-- 最近日志 -->
                            <ui:TextBlock Margin="0,12,0,6"
                                          Style="{StaticResource AppSectionLabel}"
                                          Text="最近日志"/>
                            <ItemsControl ItemsSource="{Binding DetailLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TaskLogItem}">
                                        <ui:TextBlock Style="{StaticResource AppLogLine}" Text="{Binding Text}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ui:TabViewItem>
        </ui:TabView>

        <!-- 运行遥测（常驻） -->
        <ui:Card Grid.Row="4" Padding="14,12,14,12">
            <StackPanel>
                <ui:Card Margin="0,0,0,12"
                         Padding="12,10,12,10"
                         Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="当前任务 · 最终视频规格"/>
                        <ui:TextBlock Margin="0,4,0,0"
                                      Style="{StaticResource AppBodyText}"
                                      Text="{Binding CurrentVideoSpecText}"
                                      TextWrapping="Wrap"/>
                        <ui:TextBlock Margin="0,3,0,0"
                                      Style="{StaticResource AppCaptionMuted}"
                                      Text="{Binding CurrentVideoSpecSubText}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding CurrentVideoSpecSubText}"/>
                    </StackPanel>
                </ui:Card>

                <Grid Margin="0,0,0,10">
                    <ui:TextBlock HorizontalAlignment="Left"
                                  Style="{StaticResource AppCardTitle}"
                                  Text="运行遥测"/>
                    <ui:TextBlock HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AppCaptionMuted}"
                                  Text="UI 最高 4 Hz 合并 · 任务列表最多每秒刷新一次，避免反向影响捕获管线"/>
                </Grid>

                <UniformGrid Columns="5">
                    <ui:Card Margin="0,0,6,0" Padding="10,8,10,8">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="积压"/>
                            <ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding BacklogValueText}"/>
                            <ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding BacklogSubText}"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="6,0,6,0" Padding="10,8,10,8">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="编码速率"/>
                            <ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding EncoderRateText}"/>
                            <ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding EncoderRateSubText}"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="6,0,6,0" Padding="10,8,10,8">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="消费比"/>
                            <ui:TextBlock Style="{StaticResource AppMetricNumber}"
                                          Text="{Binding ConsumptionRatioText}"
                                          Foreground="{Binding ConsumptionRatioSeverity, Converter={StaticResource StateBrush}, ConverterParameter=text}"/>
                            <ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding ConsumptionSubText}"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="6,0,0,0" Padding="10,8,10,8">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="监视盘剩余"/>
                            <ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding DiskFreeText}"/>
                            <ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding DiskSubText}"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="6,0,0,0" Padding="10,8,10,8">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="预计剩余时间"/>
                            <ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding RemainingTimeText}"/>
                            <ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding RemainingTimeSubText}"/>
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
