<Page x:Class="Mmod.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Mmod.App.ViewModels"
      xmlns:conv="clr-namespace:Mmod.App.Converters"
      Title="设置"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanToControlAppearanceConverter x:Key="SegmentAppearance"/>
        <Style x:Key="PreviewReplayTreeItem"
               TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource DefaultTreeViewItemStyle}">
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded"
                    Value="{Binding Header.IsExpanded, RelativeSource={RelativeSource Self}, Mode=TwoWay}"/>
        </Style>

        <!-- 画质参数行：标签居左、数值居右；ui:Card 的模板会把内容撑满，行宽即容器宽 -->
        <DataTemplate x:Key="QualityParameterTemplate" DataType="{x:Type vm:QualityParameterViewModel}">
            <ui:Card Margin="0,0,0,6" Padding="10,8,10,8">
                <Grid>
                    <ui:TextBlock HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AppFieldLabel}"
                                  Margin="0"
                                  Text="{Binding DisplayName}"/>
                    <ui:TextBlock HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource AppMonoText}"
                                  Text="{Binding DisplayValue}"/>
                </Grid>
            </ui:Card>
        </DataTemplate>

        <!--
            画质模块卡：左右结构
              左列：启用开关 + 模块名 + 风险/说明 + 恢复默认值
              右列：参数行，撑满剩余宽度
            容器用 ui:Card 而不是 ui:CardControl：
              CardControl 的模板是 [Icon][Header(*）][Content(Auto)] 三列，Content 落在末尾
              Auto 列，会按「内容的自然宽度」右对齐并溢出卡片（在无限宽度下测量，
              TextWrapping 文本也不会换行）；ui:Card 的 ContentPresenter 是 Stretch，
              内容才真正 100% 宽。CardControl 的语义是「左标题 + 右侧单个控件」的行，
              不适合承载整块内容。
        -->
        <DataTemplate x:Key="QualityModuleTemplate" DataType="{x:Type vm:QualityModuleViewModel}">
            <ui:Card Margin="0,0,0,10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Top">
                        <ui:ToggleSwitch HorizontalAlignment="Left"
                                         IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                         OnContent="{Binding DisplayName}"
                                         OffContent="{Binding DisplayName}"/>

                        <ui:TextBlock Margin="0,8,0,0"
                                      Style="{StaticResource AppRiskText}"
                                      Text="{Binding RiskDescription}"
                                      Visibility="{Binding HasRiskText, Converter={StaticResource BoolToVis}}"/>

                        <ui:TextBlock Margin="0,6,0,0"
                                      Style="{StaticResource AppCaptionMuted}"
                                      Text="{Binding ModuleHint}"
                                      Visibility="{Binding HasModuleHint, Converter={StaticResource BoolToVis}}"/>

                        <ui:HyperlinkButton Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Content="恢复默认值"
                                            Command="{Binding RestoreDefaultsCommand}"/>
                    </StackPanel>

                    <ItemsControl Grid.Column="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Parameters}"
                                  ItemTemplate="{StaticResource QualityParameterTemplate}"/>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <ui:TextBlock Style="{StaticResource AppPageTitle}" Text="设置"/>
            <ui:TextBlock Style="{StaticResource AppPageSubtitle}"
                          Text="改动即时生效并写入 settings.json，不需要保存按钮；新建任务时冻结为快照"/>
        </StackPanel>

        <!--
            横向页签导航
            用 ui:TabView（框架组件）；页签头面板由框架模板提供（TabPanel Margin=0），
            960px 下页签自然换行排布，不裁切、不挤压。
            公共页签两模式常显；「游戏 TGA」/「OBS 模式」是模式专属页签，
            由 IsTgaMode / IsObsMode 控制显隐（ui:TabView 与 ui:TabViewItem 是
            TabControl / TabItem 的空派生，Collapsed 会同时隐藏页签头与内容，
            且不造成索引位移）。SelectedIndex 绑定到 VM，切换模式时若停留在
            另一模式的专属页签，会被强制回到公共页签。
        -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="7*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- 常驻画质预览：独立于右侧设置页签，参数调整后可立即重新生成。 -->
            <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <ui:TextBlock Style="{StaticResource AppCardTitle}" Text="画面预览"/>
                        <ui:TextBlock Margin="0,5,0,0"
                                      Style="{StaticResource AppCaptionMuted}"
                                      TextWrapping="Wrap"
                                      Text="先从 Momentum 回放生成固定 60× 慢放、60fps 的未合成底片；之后可反复应用右侧 N、快门与画质参数。"/>
                    </StackPanel>

                    <Border x:Name="QualityPreviewViewport"
                            Grid.Row="1"
                            Background="#FF101010"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            SizeChanged="OnQualityPreviewViewportSizeChanged">
                        <Grid>
                            <MediaElement x:Name="QualityPreviewPlayer"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          ScrubbingEnabled="True"
                                          MediaOpened="OnQualityPreviewMediaOpened"
                                          MediaEnded="OnQualityPreviewMediaEnded"
                                          MediaFailed="OnQualityPreviewMediaFailed"/>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="24"
                                        Visibility="{Binding HasNoQualityPreview, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="VideoClip24"
                                               FontSize="36"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="White"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="搜索并选择一条 Momentum 回放"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="QualityPreviewPositionSlider"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Minimum="0"
                                Maximum="1"
                                IsEnabled="False"
                                IsMoveToPointEnabled="True"
                                ValueChanged="OnQualityPreviewPositionChanged"/>
                        <TextBlock x:Name="QualityPreviewPositionText"
                                   Grid.Column="1"
                                   MinWidth="92"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="00:00 / 00:00"/>
                    </Grid>

                    <ui:TabView Grid.Row="3"
                                Margin="0,12,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                SelectedIndex="{Binding SelectedQualityPreviewStageIndex, Mode=TwoWay}">
                        <ui:TabViewItem Header="阶段 1 · 获取底片">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Margin="0,0,8,0"
                                        PlaceholderText="地图、玩家或回放文件名（留空显示最新）"
                                        Text="{Binding QualityPreviewSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:Button Grid.Column="1"
                                       Content="搜索回放"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Command="{Binding SearchQualityPreviewReplaysCommand}"/>
                        </Grid>
                        <Border Margin="0,0,0,8"
                                Height="132"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TreeView ItemsSource="{Binding QualityPreviewReplayTree}"
                                      SelectedItemChanged="OnQualityPreviewReplaySelected"
                                      Style="{StaticResource AppTreeView}"
                                      ItemContainerStyle="{StaticResource PreviewReplayTreeItem}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:PreviewReplayTreeNode}"
                                                              ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Border>
                        <WrapPanel>
                            <ui:Button Content="阶段 1 · 获取60×底片"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Command="{Binding CreateQualityPreviewCommand}"
                                       Margin="0,0,8,8"/>
                            <ui:Button Content="选择并预览阶段1"
                                       Command="{Binding ShowQualityPreviewSourceCommand}"
                                       Margin="0,0,8,8"/>
                            <ui:Button Content="在资源管理器中显示"
                                       Command="{Binding OpenQualityPreviewCommand}"
                                       Margin="0,0,8,8"/>
                        </WrapPanel>
                        <ui:TextBlock Margin="0,2,0,0"
                                      Style="{StaticResource AppCaptionMuted}"
                                      TextWrapping="Wrap"
                                      Text="{Binding QualityPreviewStatus}"/>

                            </StackPanel>
                            </ScrollViewer>
                        </ui:TabViewItem>

                        <ui:TabViewItem Header="阶段 2 · 参数合成">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,0,0">
                                <WrapPanel>
                                    <ui:Button Content="阶段 2 · 并行合成"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Command="{Binding UpdateQualityPreviewCommand}"
                                               Margin="0,0,8,8"/>
                                    <ui:Button Content="预览阶段2"
                                               Command="{Binding ShowQualityPreviewResultCommand}"
                                               Margin="0,0,8,8"/>
                                    <ui:Button Content="选择并预览阶段1"
                                               Command="{Binding ShowQualityPreviewSourceCommand}"
                                               Margin="0,0,8,8"/>
                                    <ui:Button Content="在资源管理器中显示"
                                               Command="{Binding OpenQualityPreviewCommand}"
                                               Margin="0,0,8,8"/>
                                </WrapPanel>
                                <ui:TextBlock Margin="0,2,0,0"
                                              Style="{StaticResource AppCaptionMuted}"
                                              TextWrapping="Wrap"
                                              Text="{Binding QualityPreviewStatus}"/>

                        <ui:Card Margin="0,10,0,0" Padding="10,8,10,8"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="本次预览录制参数"/>
                                <ui:TextBlock Margin="0,3,0,0"
                                              Style="{StaticResource AppCaptionMuted}"
                                              TextWrapping="Wrap"
                                              Text="{Binding PreviewCaptureSettingsText}"/>
                            </StackPanel>
                        </ui:Card>

                        <Grid Margin="0,10,0,4">
                            <ui:TextBlock Style="{StaticResource AppCardTitle}" Text="预览运行遥测"/>
                            <ui:TextBlock HorizontalAlignment="Right"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="最高 4 Hz"/>
                        </Grid>
                        <UniformGrid Columns="2">
                            <ui:Card Margin="0,0,4,4" Padding="8,6,8,6">
                                <StackPanel><ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="积压"/><ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding PreviewBacklogValueText}"/><ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding PreviewBacklogSubText}"/></StackPanel>
                            </ui:Card>
                            <ui:Card Margin="4,0,0,4" Padding="8,6,8,6">
                                <StackPanel><ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="编码速率"/><ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding PreviewEncoderRateText}"/><ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding PreviewEncoderRateSubText}"/></StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,4,4,4" Padding="8,6,8,6">
                                <StackPanel><ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="消费比"/><ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding PreviewConsumptionValueText}"/><ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding PreviewConsumptionSubText}"/></StackPanel>
                            </ui:Card>
                            <ui:Card Margin="4,4,0,4" Padding="8,6,8,6">
                                <StackPanel><ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="监视盘剩余"/><ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding PreviewDiskValueText}"/><ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding PreviewDiskSubText}"/></StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,4,4,0" Padding="8,6,8,6">
                                <StackPanel><ui:TextBlock Style="{StaticResource AppMetricLabel}" Text="预计剩余"/><ui:TextBlock Style="{StaticResource AppMetricNumber}" Text="{Binding PreviewEtaValueText}"/><ui:TextBlock Style="{StaticResource AppMetricSub}" Text="{Binding PreviewEtaSubText}"/></StackPanel>
                            </ui:Card>
                        </UniformGrid>
                            </StackPanel>
                            </ScrollViewer>
                        </ui:TabViewItem>
                    </ui:TabView>
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent" Cursor="SizeWE">
                            <Border Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <ui:TabView Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectedIndex="{Binding SelectedSettingsSectionIndex, Mode=TwoWay}">

            <!-- 页签一：捕获与合成 -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Video24" Margin="0,0,6,0"/>
                        <TextBlock Text="捕获与合成" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <ScrollViewer Padding="0,12,8,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                              Margin="0,0,0,12"
                                              Text="成片输出目录"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0"
                                                Margin="0,0,8,0"
                                                PlaceholderText="请选择 MP4 成片保存目录"
                                                Text="{Binding VideoOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <ui:Button Grid.Column="1"
                                               Content="浏览…"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Command="{Binding BrowseVideoOutputCommand}"/>
                                </Grid>
                                <ui:TextBlock Margin="0,8,0,0"
                                              Style="{StaticResource AppCaptionMuted}"
                                              Text="OBS 与游戏 TGA 共用此目录；改动会立即保存，新建任务时冻结到任务快照。"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14">
                            <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                          Margin="0,0,0,12"
                                          Text="运动模糊与超采样"/>

                            <ui:TextBlock Style="{StaticResource AppHelperText}"
                                          Text="顶层工作模式在标题栏切换；本页只显示当前模式的专属设置。以下超采样、运动模糊与画质参数为两种模式共用的同一份配置。"/>

                            <Border Margin="0,12,0,4"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <ui:TextBlock Style="{StaticResource AppBodyTextStrong}"
                                                      Text="KSF 风格 · 极致运动模糊"/>
                                        <ui:TextBlock Margin="0,4,0,0"
                                                      Style="{StaticResource AppHelperText}"
                                                      Text="TGA 离线录制专用：60× 超采样、360° 全快门、60 fps、120 Mbps；约为默认 10× 的六倍采样负载。"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Content="应用预设"
                                               IsEnabled="{Binding IsTgaMode}"
                                               Command="{Binding ApplyKsfMaximumMotionBlurCommand}"/>
                                </Grid>
                            </Border>

                            <Grid Style="{StaticResource AppFieldRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppFieldLabel}"
                                              Margin="0"
                                              Text="超采样 N（1–64）"/>
                                <ui:NumberBox Grid.Column="1"
                                              Value="{Binding SupersamplingMultiplier, Mode=TwoWay}"
                                              ValueChanged="OnNumberBoxValueChanged"
                                              Minimum="1"
                                              Maximum="64"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Hidden"/>
                            </Grid>

                            <Border Style="{StaticResource AppDivider}"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}"
                                          Margin="0,0,0,8"
                                          Text="Motion Blur 模式"/>
                            <WrapPanel>
                                <ui:Button Content="Shutter Angle（推荐）"
                                           Appearance="{Binding IsShutterMode, Converter={StaticResource SegmentAppearance}}"
                                           Style="{StaticResource AppSegmentButton}"
                                           Command="{Binding SetShutterModeCommand}"
                                           Margin="0,0,6,6"/>
                                <ui:Button Content="Legacy Gaussian"
                                           Appearance="{Binding IsLegacyMode, Converter={StaticResource SegmentAppearance}}"
                                           Style="{StaticResource AppSegmentButton}"
                                           Command="{Binding SetLegacyModeCommand}"
                                           Margin="0,0,6,6"/>
                            </WrapPanel>

                            <!-- Shutter Angle 滑块 -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsShutterMode, Converter={StaticResource BoolToVis}}">
                                <ui:TextBlock Style="{StaticResource AppFieldLabel}" Text="Shutter Angle"/>
                                <Slider Minimum="180" Maximum="360"
                                        SmallChange="5" LargeChange="30"
                                        TickFrequency="30"
                                        Value="{Binding ShutterAngle, Mode=TwoWay}"
                                        Margin="0,2,0,0"/>
                                <Grid Margin="0,2,0,0">
                                    <ui:TextBlock HorizontalAlignment="Left"
                                                  Style="{StaticResource AppMonoMuted}"
                                                  Text="180°"/>
                                    <ui:TextBlock HorizontalAlignment="Center"
                                                  FontFamily="JetBrains Mono, Consolas, monospace"
                                                  FontTypography="Caption"
                                                  Text="{Binding ShutterCurrentText}"
                                                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <ui:TextBlock HorizontalAlignment="Right"
                                                  Style="{StaticResource AppMonoMuted}"
                                                  Text="360°"/>
                                </Grid>
                            </StackPanel>

                            <!-- Legacy Exposure -->
                            <Grid Style="{StaticResource AppFieldRow}"
                                  Visibility="{Binding IsLegacyMode, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppFieldLabel}"
                                              Margin="0"
                                              Text="Exposure（Legacy Gaussian 宽度）"/>
                                <ui:NumberBox Grid.Column="1"
                                              Value="{Binding Exposure, Mode=TwoWay}"
                                              ValueChanged="OnNumberBoxValueChanged"
                                              Minimum="0.05"
                                              Maximum="1"
                                              SmallChange="0.05"
                                              SpinButtonPlacementMode="Hidden"/>
                            </Grid>

                            <ui:TextBlock Margin="0,12,0,0"
                                          Style="{StaticResource AppHelperText}"
                                          Text="Exposure 是 Legacy Gaussian 的权重分布宽度；Shutter Angle 为推荐模式，有效样本 ≈ N × angle / 360。兼顾 4K60 上传与 1080p30 观看，建议先 AB 测试 300°–360°。"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>

            <!-- 页签二：画质处理 -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Wand24" Margin="0,0,6,0"/>
                        <TextBlock Text="画质处理" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <ScrollViewer Padding="0,12,8,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True">
                    <StackPanel>
                        <!-- 概览卡：左右结构 —— 左侧标题与说明，右侧唯一控件（预设下拉） -->
                        <ui:Card Margin="0,0,0,12" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <ui:TextBlock Style="{StaticResource AppCardTitle}" Text="画质处理"/>
                                    <ui:TextBlock Margin="0,6,0,0"
                                                  Style="{StaticResource AppHelperText}"
                                                  Text="处理发生在 1080p60 中间母版阶段，目标是提升平台低码率转码后的高速运动观感，不是暂停截图的锐度。全部可独立关闭，关闭时保持旧版输出。"/>
                                    <ui:TextBlock Margin="0,10,0,0"
                                                  Style="{StaticResource AppBodyTextStrong}"
                                                  Text="{Binding ProcessingSummary}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <ui:TextBlock Style="{StaticResource AppFieldLabel}"
                                                  Margin="0,0,0,4"
                                                  Text="预设"/>
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding PresetOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedPresetId, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <ItemsControl ItemsSource="{Binding QualityModules}"
                                      ItemTemplate="{StaticResource QualityModuleTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>

            <!-- 页签三：后期 / 4K 工作流 -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0"/>
                        <TextBlock Text="后期 / 4K" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <ScrollViewer Padding="0,12,8,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                              Margin="0,0,0,12"
                                              Text="输出"/>
                                <ui:TextBlock Style="{StaticResource AppHelperText}"
                                              Text="{Binding OutputDirectoryText}"/>
                                <ui:TextBlock Margin="0,6,0,0"
                                              Style="{StaticResource AppHelperText}"
                                              Text="1920×1080 / 60fps · 命名 地图_玩家_时间戳.mp4"/>
                                <ui:TextBlock Margin="0,6,0,0"
                                              Style="{StaticResource AppCaptionMuted}"
                                              Text="本工具只输出画面；音频（48kHz AAC ≈320kbps）在 DaVinci 中加入"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14">
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                              Margin="0,0,0,12"
                                              Text="4K 工作流"/>
                                <ui:ToggleSwitch IsChecked="{Binding EnableDaVinci4KWorkflowGuide, Mode=TwoWay}"
                                                 OnContent="DaVinci 4K AI 后处理指引"
                                                 OffContent="DaVinci 4K AI 后处理指引"/>
                                <ui:TextBlock Margin="0,8,0,0"
                                              Style="{StaticResource AppCaptionMuted}"
                                              Text="本工具不会执行 AI 放大。这里仅生成 DaVinci Resolve Studio 中的操作步骤（Super Scale 2x Enhanced 属 Studio 功能）。"/>
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding IsDaVinciGuideEnabled, Converter={StaticResource BoolToVis}}">
                                    <WrapPanel Margin="0,0,0,8">
                                        <ui:Button Content="复制 DaVinci 操作步骤"
                                                   Icon="{ui:SymbolIcon Copy24}"
                                                   Command="{Binding CopyDaVinciStepsCommand}"
                                                   Margin="0,0,8,8"/>
                                        <ui:Button Content="复制 Bilibili 导出建议"
                                                   Icon="{ui:SymbolIcon Copy24}"
                                                   Command="{Binding CopyBilibiliExportCommand}"
                                                   Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <ui:TextBox Style="{StaticResource AppCodeBlock}"
                                                Text="{Binding DavinciGuideText}"
                                                MinHeight="200"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>

            <!-- 页签四：游戏 TGA（页签索引 3，仅 TGA 模式显示）
                 索引与 SettingsViewModel.TgaOnlySectionIndex 一一对应；
                 调整页签顺序时必须同步该常量。 -->
            <ui:TabViewItem Visibility="{Binding IsTgaMode, Converter={StaticResource BoolToVis}}">
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Map24" Margin="0,0,6,0"/>
                        <TextBlock Text="游戏 TGA" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <ScrollViewer Padding="0,12,8,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True">
                    <ui:Card Padding="14">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                          Margin="0,0,0,12"
                                          Text="游戏 TGA 模式"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Text="TGA 监视目录"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True"
                                            Text="{Binding RamDiskWatchDirectory, Mode=TwoWay}"/>
                                <ui:Button Grid.Column="1" Content="浏览…"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding BrowseWatchDirectoryCommand}"/>
                            </Grid>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,14,0,6"
                                          Text="前台 TGA 生成速率上限（fps）"/>
                            <ui:NumberBox Value="{Binding ForegroundCaptureFpsLimit, Mode=TwoWay}"
                                          ValueChanged="OnNumberBoxValueChanged"
                                          Minimum="0" Maximum="1000" SmallChange="10"
                                          HorizontalAlignment="Left" Width="160"
                                          SpinButtonPlacementMode="Hidden"/>
                            <ui:TextBlock Margin="0,6,0,0"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="默认 90；0 表示不覆盖游戏当前 fps_max。只影响现实时间中的 TGA 生成速度，不改变超采样时间步和最终 60 fps。"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,14,0,6"
                                          Text="监视盘剩余空间安全下限（%）"/>
                            <ui:NumberBox Value="{Binding DiskSafetyFreePercent, Mode=TwoWay}"
                                          ValueChanged="OnNumberBoxValueChanged"
                                          Minimum="0" Maximum="50" SmallChange="1"
                                          HorizontalAlignment="Left" Width="160"
                                          SpinButtonPlacementMode="Hidden"/>
                            <!-- 画板 05 底部黄色警示条：阈值摘要走 ui:InfoBar（Warning=黄色警示；InfoBarSeverity 无 Caution，勿与 InfoBadgeSeverity 混用） -->
                            <ui:InfoBar Margin="0,8,0,0"
                                        Severity="Warning"
                                        Title="磁盘安全"
                                        Message="{Binding DiskSafetySummary}"
                                        IsClosable="False"
                                        IsOpen="True"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,14,0,6"
                                          Text="游戏根目录"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True"
                                            Text="{Binding GameRootPath, Mode=TwoWay}"/>
                                <ui:Button Grid.Column="1" Content="浏览…"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding BrowseGameRootCommand}"/>
                            </Grid>

                            <Border Style="{StaticResource AppDivider}"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}"
                                          Margin="0,0,0,6"
                                          Text="startmovie 序列名"/>
                            <ui:TextBox Text="{Binding MovieSequenceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,16,0">
                                    <ui:TextBlock Style="{StaticResource AppFieldLabel}" Text="开始快捷键"/>
                                    <ui:TextBox Width="80" Text="{Binding StartMovieHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource AppFieldLabel}" Text="结束快捷键"/>
                                    <ui:TextBox Width="80" Text="{Binding EndMovieHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>

                            <ui:ToggleSwitch Margin="0,12,0,0"
                                             IsChecked="{Binding HideHudInCfg, Mode=TwoWay}"
                                             OnContent="录制时隐藏游戏 HUD 与顶部回放栏"
                                             OffContent="录制时隐藏游戏 HUD 与顶部回放栏"/>

                            <Border Style="{StaticResource AppDivider}"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}"
                                          Margin="0,0,0,6"
                                          Text="执行 CFG 指令（进图后在控制台执行）"/>
                            <ui:TextBox Style="{StaticResource AppCodeBlock}" Text="{Binding CfgCommandBlock}" MinHeight="48"/>

                            <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,12,0,6"
                                          Text="还原指令（停止录制、恢复设置并关闭作弊）"/>
                            <ui:TextBox Style="{StaticResource AppCodeBlock}" Text="{Binding CfgRestoreCommandBlock}" MinHeight="64"/>

                            <WrapPanel Margin="0,14,0,0">
                                <ui:Button Content="创建并生成 CFG" Appearance="Primary"
                                           Icon="{ui:SymbolIcon DocumentAdd24}"
                                           Command="{Binding CreateJunctionCommand}" Margin="0,0,8,8"/>
                                <ui:Button Content="复制 CFG 指令"
                                           Command="{Binding CopyCfgCommandCommand}" Margin="0,0,8,8"/>
                                <ui:Button Content="复制还原指令"
                                           Command="{Binding CopyCfgRestoreCommandCommand}" Margin="0,0,8,8"/>
                                <ui:Button Content="取消 Junction" Appearance="Danger"
                                           Icon="{ui:SymbolIcon LinkDismiss24}"
                                           Command="{Binding RemoveJunctionCommand}" Margin="0,0,8,8"/>
                                <ui:Button Content="打开 ImDisk"
                                           Icon="{ui:SymbolIcon HardDrive24}"
                                           Command="{Binding OpenImDiskCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <ui:TextBlock Margin="0,4,0,0"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="{Binding JunctionState}"/>
                        </StackPanel>
                    </ui:Card>
                </ScrollViewer>
            </ui:TabViewItem>

            <!-- 页签五：OBS 模式（页签索引 4，仅 OBS 模式显示）
                 索引与 SettingsViewModel.ObsOnlySectionIndex 一一对应；
                 调整页签顺序时必须同步该常量。 -->
            <ui:TabViewItem Visibility="{Binding IsObsMode, Converter={StaticResource BoolToVis}}">
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Record24" Margin="0,0,6,0"/>
                        <TextBlock Text="OBS 模式" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <ScrollViewer Padding="0,12,8,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,12" Padding="14">
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                              Margin="0,0,0,12"
                                              Text="OBS 捕获"/>
                                <ui:TextBlock Style="{StaticResource AppFieldLabel}" Text="OBS 源帧率"/>
                                <ComboBox HorizontalAlignment="Left" Width="200"
                                             ItemsSource="{Binding ObsCaptureFramerateOptions}"
                                             SelectedItem="{Binding ObsCaptureFramerate, Mode=TwoWay}"/>

                                <ui:TextBlock Style="{StaticResource AppFieldLabel}" Margin="0,14,0,6" Text="OBS 并行路数"/>
                                <ui:NumberBox Value="{Binding MaxParallelJobs, Mode=TwoWay}"
                                              ValueChanged="OnNumberBoxValueChanged"
                                              Minimum="1" Maximum="8" SmallChange="1"
                                              HorizontalAlignment="Left" Width="160"
                                              SpinButtonPlacementMode="Hidden"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14">
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                              Margin="0,0,0,10"
                                              Text="游戏慢放指令"/>
                                <ui:ToggleSwitch Margin="0,0,0,8"
                                                 IsChecked="{Binding HideHudInCfg, Mode=TwoWay}"
                                                 OnContent="录制时隐藏游戏 HUD 与顶部回放栏"
                                                 OffContent="录制时隐藏游戏 HUD 与顶部回放栏"/>
                                <ui:TextBox Style="{StaticResource AppCodeBlock}" Text="{Binding SlowMotionBlock}" MinHeight="90"/>
                                <ui:TextBox Style="{StaticResource AppCodeBlock}" Margin="0,8,0,0" Text="{Binding RestoreBlock}" MinHeight="70"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <ui:Button Content="复制慢放指令" Icon="{ui:SymbolIcon Copy24}"
                                               Command="{Binding CopySlowMotionCommand}" Margin="0,0,8,8"/>
                                    <ui:Button Content="复制恢复指令" Icon="{ui:SymbolIcon Copy24}"
                                               Command="{Binding CopyRestoreCommand}" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>

            <!-- 页签六：编码（公共）—— 中间母版码率；监视盘安全下限属于 TGA 专属，见「游戏 TGA」页签 -->
            <ui:TabViewItem>
                <ui:TabViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Code24" Margin="0,0,6,0"/>
                        <TextBlock Text="编码" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:TabViewItem.Header>

                <ScrollViewer Padding="0,12,8,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="True">
                    <ui:Card Padding="14">
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource AppCardTitle}"
                                          Margin="0,0,0,12"
                                          Text="中间母版码率"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppKeyText}"
                                              Text="目标码率（Mbps）"/>
                                <ui:NumberBox Grid.Column="1"
                                              Value="{Binding IntermediateTargetBitrateMbps, Mode=TwoWay}"
                                              ValueChanged="OnNumberBoxValueChanged"
                                              Minimum="0"
                                              Maximum="120"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Hidden"/>
                            </Grid>
                            <ui:TextBlock Margin="0,8,0,0"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="{Binding BitrateSummaryText}"/>
                            <ui:TextBlock Margin="0,4,0,0"
                                          Style="{StaticResource AppCaptionMuted}"
                                          Text="0 = 自动估算；可设置 1–120 Mbps。数值越大，编码器可使用的码率越高，通常画质越好、文件也越大；实际平均码率会随画面复杂度和硬件编码器而波动。两种模式共用同一份设置。"/>
                        </StackPanel>
                    </ui:Card>
                </ScrollViewer>
            </ui:TabViewItem>
            </ui:TabView>
        </Grid>
    </Grid>
</Page>
