<ui:FluentWindow x:Class="Mmod.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Mmod.App.Views.Pages"
                 xmlns:models="clr-namespace:Mmod.Core.Models;assembly=Mmod.Core"
                 Title="{x:Static models:ProjectConstants.ApplicationDisplayName}"
                 Height="720"
                 Width="960"
                 MinHeight="600"
                 MinWidth="780"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <ui:NavigationView x:Name="RootNavigation"
                           Padding="28,0,28,0"
                           TitleBar="{Binding ElementName=TitleBar}"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="200"
                           PaneDisplayMode="Left"
                           FrameMargin="0,0,0,12">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="合成"
                                       Icon="{ui:SymbolIcon Video24}"
                                       TargetPageType="{x:Type pages:ComposePage}" />
                <ui:NavigationViewItem Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
        <ui:TitleBar x:Name="TitleBar"
                     Title="{x:Static models:ProjectConstants.ApplicationDisplayName}"
                     CloseWindowByDoubleClickOnIcon="True" />
    </Grid>
</ui:FluentWindow>
