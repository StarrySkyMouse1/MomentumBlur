<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mmod.Core\Mmod.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>mmod_record_next</AssemblyName>
    <Product>Momentum 运动模糊合成</Product>
    <RootNamespace>Mmod.App</RootNamespace>
    <!-- Set SkipNativeBuild=true to skip cmake when iterating on C# only -->
    <SkipNativeBuild Condition="'$(SkipNativeBuild)' == ''">false</SkipNativeBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\tools\ImDisk\**\*"
             Link="ImDisk\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <NativeRoot>$(MSBuildThisFileDirectory)..\Mmod.Native</NativeRoot>
    <NativeBuildDir>$(MSBuildThisFileDirectory)..\Mmod.Native\build</NativeBuildDir>
    <NativeDll>$(MSBuildThisFileDirectory)..\Mmod.Native\build\bin\$(Configuration)\mmod_native.dll</NativeDll>
    <!-- Inside Visual Studio, resolve the CMake bundled with the current VS instance.
         This works for custom install roots and Preview/Insiders editions on every machine. -->
    <_VsBundledCMakeFromDevEnv>$(DevEnvDir)CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</_VsBundledCMakeFromDevEnv>
    <_VsBundledCMake>$(VSINSTALLDIR)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</_VsBundledCMake>
    <!-- VS-hosted MSBuild does not always expose VSINSTALLDIR. MSBuildToolsPath is under
         <VS root>\MSBuild\Current\Bin, so it provides a location-independent fallback. -->
    <_VsRootFromMSBuild>$([System.IO.Path]::GetFullPath('$(MSBuildToolsPath)\..\..\..\'))</_VsRootFromMSBuild>
    <_VsBundledCMakeFromMSBuild>$(_VsRootFromMSBuild)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</_VsBundledCMakeFromMSBuild>
    <CMakeExe Condition="'$(CMakeExe)' == '' and '$(DevEnvDir)' != '' and Exists('$(_VsBundledCMakeFromDevEnv)')">$(_VsBundledCMakeFromDevEnv)</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and '$(VSINSTALLDIR)' != '' and Exists('$(_VsBundledCMake)')">$(_VsBundledCMake)</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('$(_VsBundledCMakeFromMSBuild)')">$(_VsBundledCMakeFromMSBuild)</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">C:\Program Files\Microsoft Visual Studio\2022\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('D:\Software\Professionals\vs2022\Enterprise\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">D:\Software\Professionals\vs2022\Enterprise\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('D:\Software\Professionals\vs2022\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">D:\Software\Professionals\vs2022\Professional\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)' == '' and Exists('D:\Software\Professionals\vs2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">D:\Software\Professionals\vs2022\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <!-- Command-line builds may provide CMake through PATH. Do not reject that valid setup. -->
    <CMakeExe Condition="'$(CMakeExe)' == ''">cmake</CMakeExe>
    <CMakeGenerator Condition="'$(CMakeGenerator)' == '' and $([System.String]::Copy('$(VisualStudioVersion)').StartsWith('18.'))">Visual Studio 18 2026</CMakeGenerator>
    <CMakeGenerator Condition="'$(CMakeGenerator)' == '' and $([System.String]::Copy('$(VisualStudioVersion)').StartsWith('17.'))">Visual Studio 17 2022</CMakeGenerator>
  </PropertyGroup>

  <!-- 若 build 目录中的 CMake 缓存记录的不是当前源码目录（仓库移动/复制后），
       先清掉整个生成目录，让下方 cmake configure 重新生成，避免 cmake build 报缓存路径不匹配 -->
  <Target Name="EnsureNativeCacheFresh" BeforeTargets="BuildNativeDll"
          Condition="Exists('$(NativeBuildDir)\CMakeCache.txt')">
    <PropertyGroup>
      <!-- 先规范化（$(NativeRoot) 含 ..\，与 CMake 缓存中的绝对路径不匹配），再统一为 / 比较 -->
      <_NativeRootFwd>$([System.IO.Path]::GetFullPath('$(NativeRoot)').Replace('\', '/'))</_NativeRootFwd>
      <_NativeCacheText>$([System.IO.File]::ReadAllText('$(NativeBuildDir)\CMakeCache.txt'))</_NativeCacheText>
      <_CacheMatchesRoot>$([System.String]::Copy('$(_NativeCacheText)').Contains('$(_NativeRootFwd)'))</_CacheMatchesRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(NativeBuildDir)" Condition="'$(_CacheMatchesRoot)' == 'false'" />
  </Target>

  <Target Name="BuildNativeDll" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeBuild)' != 'true'">
    <Exec Command="&quot;$(CMakeExe)&quot; -S &quot;$(NativeRoot)&quot; -B &quot;$(NativeBuildDir)&quot; -G &quot;$(CMakeGenerator)&quot; -A x64"
          Condition="!Exists('$(NativeBuildDir)\mmod_native.vcxproj') and '$(CMakeGenerator)' != ''" />
    <Exec Command="&quot;$(CMakeExe)&quot; -S &quot;$(NativeRoot)&quot; -B &quot;$(NativeBuildDir)&quot; -A x64"
          Condition="!Exists('$(NativeBuildDir)\mmod_native.vcxproj') and '$(CMakeGenerator)' == ''" />
    <Exec Command="&quot;$(CMakeExe)&quot; --build &quot;$(NativeBuildDir)&quot; --config $(Configuration)" />
  </Target>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Warning Text="未找到 $(NativeDll)。Native 构建可能失败；可手动：cmake --build src\Mmod.Native\build --config $(Configuration)"
             Condition="!Exists('$(NativeDll)')" />
    <Copy SourceFiles="$(NativeDll)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeDll)')" />
  </Target>

</Project>
